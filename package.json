{
  "name": "lyza",
  "version": "1.0.0",
  "description": "Lyza - A beautiful text analysis tool built with Electron",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": ["electron", "text-analysis", "character-count", "word-count"],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "tailwindcss": "^3.3.6"
  },
  "build": {
    "appId": "com.lyza.app",
    "productName": "Lyza",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "styles/**/*",
      "node_modules/**/*"
    ]
  }
} 